# ─── Mode ────────────────────────────────────────────────────
# 'org' = multi-agent workspace  |  'agent' = single-agent deployment
NEXT_PUBLIC_XO_MODE=org

# Fixed agent ID for agent-only mode (ignored in org mode)
NEXT_PUBLIC_XO_AGENT_ID=aria

# ─── Backend ─────────────────────────────────────────────────
# Primary backend server URL (sessions, tasks, workspace)
XO_BACKEND_URL=http://localhost:8000

# Optional: separate backend URL for agent mode
# XO_AGENT_BACKEND_URL=http://localhost:8001

# ─── Auth ────────────────────────────────────────────────────
# Secret used to sign agent tokens (xo_ag_{id}_{hmac})
# IMPORTANT: change this in production
XO_SERVER_SECRET=xo-dev-secret-change-me

# ─── Storage ─────────────────────────────────────────────────
# Optional: custom workspace root directories
# XO_STORAGE_ROOT=/path/to/org/workspace
# XO_AGENT_STORAGE_ROOT=/path/to/agent/workspace

# ─── OpenClaw Gateway ────────────────────────────────────────
# Connect OpenClaw agents to the org. See docs/paperclip-orchestration/
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=xo
# OPENCLAW_SESSIONS_DIR=             # Path to sessions .jsonl files

# ─── GitHub App ─────────────────────────────────��────────────
# Register a GitHub App at https://github.com/settings/apps/new
# See docs/github-connector.md for full setup instructions
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=          # Base64-encoded PEM private key
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=xo-org         # Your GitHub App's URL slug

# ─── Gmail (Google OAuth 2.0) ────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# See docs/gmail-connector.md for full setup instructions
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# ─── Slack App ───────────────────────────────────────────────
# Create a Slack App at https://api.slack.com/apps
# See docs/slack-connector.md for full setup instructions
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# SLACK_REDIRECT_URI=http://localhost:3000/api/slack/callback

# ─── Stripe Connect ─────────────────────────────────────────
# Enable Stripe Connect OAuth at https://dashboard.stripe.com/settings/applications
# See docs/stripe-connector.md for full setup instructions
STRIPE_SECRET_KEY=                   # sk_test_... or sk_live_...
STRIPE_CLIENT_ID=                    # ca_... from Connect settings
STRIPE_WEBHOOK_SECRET=               # whsec_... from Webhooks
# STRIPE_REDIRECT_URI=http://localhost:3000/api/stripe/callback

# ─── Vercel Integration ──────────────────────────────────────
# Create at https://vercel.com/dashboard/integrations/console
# See docs/vercel-connector.md for full setup instructions
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=xo-org       # URL slug of your integration
# VERCEL_REDIRECT_URI=http://localhost:3000/api/vercel/callback

# ─── Rclone ─────────────────────────────────────────────────
# No API keys needed — rclone is a local CLI tool.
# Optional overrides (defaults work for standard installs):
# RCLONE_PATH=rclone                   # Path to rclone binary (if not in PATH)
# RCLONE_CONFIG=                       # Path to rclone.conf (uses default if empty)

# ─── Token Encryption ───────────────────────────────────────
# Used to encrypt OAuth tokens at rest (Gmail, Slack, Stripe, Vercel, etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
